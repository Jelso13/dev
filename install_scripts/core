#!/usr/bin/env bash

# Basic command line utilities for just using a system - should be very lightweight

log_info "=== Starting Core Installation ==="

# ------------------------------------------------------------------------------
# System Packages (OS Specific)
# ------------------------------------------------------------------------------
log_info "Installing system packages..."

# Tools that share the exact same name on both Debian and Arch
COMMON_TOOLS="curl git stow fzf tmux tar jq"

if [[ "$system_type" == "debian" ]]; then
    system_install $COMMON_TOOLS fd-find xz-utils pinentry-curses ssh gpg
elif [[ "$system_type" == "arch" ]]; then
    system_install $COMMON_TOOLS fd xz pinentry openssh gnupg
else
    system_install $COMMON_TOOLS fd xz-utils pinentry openssh gnupg
    log_warn "Unsupported system type: $system_type"
fi

log_info "=== Starting Development Installation ==="

# ------------------------------------------------------------------------------
# System Packages (OS Specific)
# ------------------------------------------------------------------------------
log_info "Installing system packages..."

# Tools that share the exact same name on both Debian and Arch
COMMON_TOOLS=" clang"

if [[ "$system_type" == "debian" ]]; then
    system_install $COMMON_TOOLS g++ python3 python3-pip lua5.4 libclang-dev
elif [[ "$system_type" == "arch" ]]; then
    system_install $COMMON_TOOLS gcc python python-pip lua luajit llvm
else
    system_install $COMMON_TOOLS llvm python3 python-pip lua54 clang
    log_warn "Unsupported system type: $system_type"
fi

curl -fsSL https://pyenv.run | bash

# ------------------------------------------------------------------------------
# Rust & Cargo
# ------------------------------------------------------------------------------
if command -v rustup &>/dev/null && command -v cargo &>/dev/null; then
    log_pass "Rust/Cargo is already installed."
else
    log_info "Installing Rust toolchain..."
    
    if [[ -n "${XDG_DATA_HOME:-}" ]]; then
        export CARGO_HOME="$XDG_DATA_HOME/cargo"
        export RUSTUP_HOME="$XDG_DATA_HOME/rustup"
    fi
    
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
    export PATH="$HOME/.cargo/bin:$PATH"
fi

# ------------------------------------------------------------------------------
# Node & NVM
# ------------------------------------------------------------------------------
if command -v npm &>/dev/null; then
    log_pass "NPM is already installed."
else
    log_info "Installing NVM and Node 22..."
    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash
    
    export NVM_DIR="$HOME/.nvm"
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    
    nvm install 22
    log_pass "Node version: $(node -v)"
fi

# ------------------------------------------------------------------------------
# Starship Prompt
# ------------------------------------------------------------------------------
if command -v starship &>/dev/null; then
    log_pass "Starship is already installed."
else
    log_info "Installing Starship..."
    curl -sS https://starship.rs/install.sh | sh -s -- -y
fi

# ------------------------------------------------------------------------------
# Nerd Fonts
# ------------------------------------------------------------------------------
FONT_DIR="$HOME/.local/share/fonts"
if [[ -f "$FONT_DIR/RobotoMonoNerdFont-Regular.ttf" ]]; then
    log_pass "RobotoMono NerdFont is already installed."
else
    log_info "Downloading RobotoMono Nerd Font..."
    mkdir -p "$FONT_DIR"
    
    # Run in a subshell so we don't accidentally change the script's working directory
    (
        cd "$FONT_DIR"
        curl -LO https://github.com/ryanoasis/nerd-fonts/releases/latest/download/RobotoMono.tar.xz
        tar -xvf RobotoMono.tar.xz
        rm RobotoMono.tar.xz
    )
    # Refresh font cache (Linux)
    if command -v fc-cache &>/dev/null; then
        fc-cache -fv
    fi
fi




log_info "=== Development Installation Complete ==="


log_info "=== Starting Neovim Installation ==="

local target_version="0.12.1"

# -------------------------------- Idempotency ---------------------------------

if command -v nvim &>/dev/null; then
    local current_version
    current_version=$(nvim --version | head -n 1 | awk '{print $2}')
    
    if [[ "$current_version" == "v$target_version" ]]; then
        log_pass "Neovim $current_version is already installed. Skipping build."
        return 0
    fi
    log_info "Neovim version mismatch (Found: $current_version). Rebuilding..."
fi


# ------------------------------ Dependencies ----------------------------------
log_info "Installing build dependencies and python providers..."

if [[ "$system_type" == "debian" ]]; then
    system_install cmake gettext lua5.1 liblua5.1-0-dev python3-pynvim
elif [[ "$system_type" == "arch" ]]; then
    # Arch uses python-pynvim instead of python3-pynvim
    system_install cmake gettext lua python-pynvim 
else
    system_install cmake gettext lua5.1 liblua5.1-0-dev python3-pynvim
    log_warn "Unsupported system type: $system_type"
fi

check_deps git cargo make cmake g++ || return 1


# -------------------------------- Clone + Build -------------------------------
log_info "Cloning and building Neovim v${target_version} (this may take a minute)..."
local download_dir="$HOME/neovim_source"

# Run the build process in a subshell so 'cd' doesn't break the parent script
(
    mkdir -p "$download_dir"
    
    if [[ ! -d "$download_dir/.git" ]]; then
        git clone -b "v$target_version" https://github.com/neovim/neovim.git "$download_dir"
    else
        git -C "$download_dir" fetch --tags
        git -C "$download_dir" checkout "v$target_version"
    fi

    cd "$download_dir"
    make CMAKE_BUILD_TYPE=Release
    
    if [[ $DRY_RUN -eq 0 ]]; then
        sudo make install
    else
        log_info "[DRY_RUN] Would execute: sudo make install"
    fi
)

# Clean up source files to keep the system slim
if [[ $DRY_RUN -eq 0 ]]; then
    rm -rf "$download_dir"
fi

# ----------------------------------- Treesitter -------------------------------
if command -v cargo &>/dev/null; then
    log_info "Installing tree-sitter-cli via Cargo..."
    if [[ $DRY_RUN -eq 0 ]]; then
        cargo install tree-sitter-cli
    else
        log_info "[DRY_RUN] Would execute: cargo install tree-sitter-cli"
    fi
else
    log_error "Cargo is not available. Skipping tree-sitter-cli."
fi

log_info "=== Neovim Installation Complete ==="

log_info "=== Core Installation Complete ==="
