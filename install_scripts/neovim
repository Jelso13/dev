#!/usr/bin/env bash

log_info "=== Starting Neovim Installation ==="

local target_version="0.10.4"

# -------------------------------- Idempotency ---------------------------------

if command -v nvim &>/dev/null; then
    local current_version
    current_version=$(nvim --version | head -n 1 | awk '{print $2}')
    
    if [[ "$current_version" == "v$target_version" ]]; then
        log_pass "Neovim $current_version is already installed. Skipping build."
        return 0
    fi
    log_info "Neovim version mismatch (Found: $current_version). Rebuilding..."
fi


check_deps git cargo make cmake g++ || return 1

# ------------------------------ Dependencies ----------------------------------
log_info "Installing build dependencies and python providers..."

if [[ "$system_type" == "debian" ]]; then
    system_install cmake gettext lua5.1 liblua5.1-0-dev python3-pynvim
elif [[ "$system_type" == "arch" ]]; then
    # Arch uses python-pynvim instead of python3-pynvim
    system_install cmake gettext lua python-pynvim 
else
    log_error "Unsupported system type: $system_type"
    return 1
fi

# -------------------------------- Clone + Build -------------------------------
log_info "Cloning and building Neovim v${target_version} (this may take a minute)..."
local download_dir="$HOME/neovim_source"

# Run the build process in a subshell so 'cd' doesn't break the parent script
(
    mkdir -p "$download_dir"
    
    if [[ ! -d "$download_dir/.git" ]]; then
        git clone -b "v$target_version" https://github.com/neovim/neovim.git "$download_dir"
    else
        git -C "$download_dir" fetch --tags
        git -C "$download_dir" checkout "v$target_version"
    fi

    cd "$download_dir"
    make CMAKE_BUILD_TYPE=Release
    
    if [[ $DRY_RUN -eq 0 ]]; then
        sudo make install
    else
        log_info "[DRY_RUN] Would execute: sudo make install"
    fi
)

# Clean up source files to keep the system slim
if [[ $DRY_RUN -eq 0 ]]; then
    rm -rf "$download_dir"
fi

# ----------------------------------- Treesitter -------------------------------
if command -v cargo &>/dev/null; then
    log_info "Installing tree-sitter-cli via Cargo..."
    if [[ $DRY_RUN -eq 0 ]]; then
        cargo install tree-sitter-cli
    else
        log_info "[DRY_RUN] Would execute: cargo install tree-sitter-cli"
    fi
else
    log_error "Cargo is not available. Skipping tree-sitter-cli."
fi

log_info "=== Neovim Installation Complete ==="

