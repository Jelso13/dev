#!/usr/bin/env bash

set -Eeuo pipefail
trap 'err_code=$?; echo -e "\x1b[38;2;255;0;0mERROR\x1b[0m: command [${BOLD}$BASH_COMMAND${NC}] failed with exit code $err_code in file ${BASH_SOURCE[0]} line $LINENO"; exit $err_code' ERR

script_dir=$(cd $(dirname "${BASH_SOURCE[0]}") &> /dev/null && pwd)
export PROJECT_ROOT=$script_dir
export script_dir

# --------------------------------- Vars ---------------------------------------

declare -i VERBOSE=0
declare -i DRY_RUN=0
declare -a POSITIONAL_ARGS

# ------------------------------ Debugging -------------------------------------

RED='\x1b[38;2;255;0;0m'
ORANGE='\x1b[38;2;255;160;70m'
GREEN='\x1b[38;2;0;255;0m'
BOLD='\x1b[1m'
LIGHTBLUE='\x1b[38;2;5;182;255m'
NC='\x1b[0m'

FAIL_COUNTER=0

log_pass() { echo -e "${GREEN}[PASS]${NC} $1"; }
log_fail() { echo -e "${RED}[FAIL]${NC} $1"; (( FAIL_COUNTER++ )); }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }
log_warn() { echo -e "${ORANGE}[WARN]${NC} $1"; }
log_info() { echo -e "${BOLD}[INFO]${NC} $1"; }
log_debug() { if [[ $VERBOSE -eq 1 ]]; then echo -e "${LIGHTBLUE}[DEBUG]${NC} $1"; fi }

# -------------------------------- Utils ---------------------------------------

usage() {
    cat <<EOF
Usage: dev [OPTIONS] <command> [targets...]

Commands:
  install, i    Install base packages and dependencies
  config, c     Apply dotfiles and configuration scripts
  secret, s     Manage encrypted secrets (targets: edit, export)

Options:
  -h, --help    Show this help message
  -v, --verbose Enable verbose logging
  --dry-run     Simulate actions without making changes
EOF
}

get_sys() {
    system_type=$(uname -s)
    system_type="unknown"
    if [[ "$(uname -s)" == "Linux" ]]; then
        if [[ -f /etc/os-release ]]; then
            source /etc/os-release
            case "$ID" in #TODO: maybe change this to ID_LIKE
                debian|ubuntu)
                    system_type="debian"
                    ;;
                arch|manjaro)
                    system_type="arch"
                    ;;
                *)
                    system_type="linux"
                    ;;
            esac
        else
            system_type="linux"
        fi
    fi
    #NOTE: can add mac and windows here too
    export system_type
}
get_sys

assert_command() {
    if command -v "$1" &>/dev/null; then
        log_info "$1 is available"
        return 0;
    else
        log_warn "$1 is not available"
        return 1;
    fi
}

check_deps() {
    local missing=()
    for dep in "$@"; do
        if ! command -v "$dep" &>/dev/null; then
            missing+=("$dep")
        fi
    done

    if [[ ${#missing[@]} -gt 0 ]]; then
        log_error "Missing required dependencies: ${RED}${missing[*]}${NC}"
        return 1
    fi
    log_debug "All dependencies met: $*"
    return 0
}


# ----------------------------- CLI Handling -----------------------------------

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -v|--verbose)
            export VERBOSE=1
            shift # remove flag
            ;;
        --dry-run)
            export DRY_RUN=1
            shift
            ;;
        -*|--*)
            log_error "Unknown option: $1" >&2
            usage
            exit 1
            ;;
        *)
            POSITIONAL_ARGS+=("$1")
            shift
            ;;
    esac
done

export VERBOSE
export DRY_RUN

log_debug "system_type = $system_type"

if [[ ${#POSITIONAL_ARGS[@]} -eq 0 ]]; then
    usage
    exit 1
fi

log_debug "POSITIONAL_ARGS: ${POSITIONAL_ARGS[*]}"

# Substitutions for common targets with multiple names
declare -A TARGET_MAP=(
    ["nvim"]="neovim"
    ["python3"]="python"
    ["awesome"]="awesomewm"
)   

COMMAND="${POSITIONAL_ARGS[0]}"
log_debug "Parsed Command: $COMMAND"
RAW_TARGETS=("${POSITIONAL_ARGS[@]:1}")
log_debug "RAW_TARGETS: ${RAW_TARGETS[*]}"

declare -a NORMALIZED_TARGETS=()
normalize_target() {
    local input="$1"
    # swap the key if it exists in the map otherwise do nothing
    echo "${TARGET_MAP[$input]:-$input}"
}

for target in "${RAW_TARGETS[@]}"; do
    NORMALIZED_TARGETS+=("$(normalize_target "$target")")
done

log_debug "NORMALIZED_TARGETS: ${NORMALIZED_TARGETS[*]}"

# -------------------------------- Secret --------------------------------------

SECRET_FILE="$PROJECT_ROOT/secret.asc"

cmd_secret_edit() {
    [[ ! -f "$SECRET_FILE" ]] && { log_error "'$SECRET_FILE' does not exist."; exit 1; }

    local tmp tmp_bak tmp_enc
    tmp="$(mktemp)"; tmp_bak="$(mktemp)"
    trap 'rm -f "$tmp" "$tmp_bak"' EXIT INT TERM

    gpg --quiet --no-symkey-cache --decrypt "$SECRET_FILE" > "$tmp" 2>/dev/null || log_error "GPG operation failed. Check ownership of \$(tty) and possibly chown."
    cp "$tmp" "$tmp_bak"

    "${EDITOR:-vi}" "$tmp"

    if cmp -s "$tmp" "$tmp_bak"; then
        log_info "No changes made. Exiting without re-encrypting."
    else
        log_info "Changes detected. Re-encrypting..."
        tmp_enc="$(mktemp --suffix=.asc)"
        
        gpg --symmetric --cipher-algo AES256 --s2k-digest-algo SHA512 --s2k-count 65011712 \
            --armor --no-symkey-cache --yes -o "$tmp_enc" "$tmp" 2>/dev/null || log_error "GPG operation failed. Check ownership of \$(tty) and possibly chown."
        
        mv -- "$tmp_enc" "$SECRET_FILE"
        log_pass "Successfully updated secret.asc."
    fi

    # Cleanup
    command -v shred >/dev/null 2>&1 && shred -u "$tmp" "$tmp_bak" 2>/dev/null || true
    trap - EXIT INT TERM
    rm -f "$tmp" "$tmp_bak"
}

_gpg_fail_help() {
    log_error "GPG operation failed." >&2
    echo -e "\n\x1b[38;2;255;165;0m--- [ TROUBLESHOOTING ] ---\x1b[0m" >&2
    echo -e "Terminal ownership might be blocked. Try:\n" >&2
    echo -e "  sudo chown \$(whoami) \$(tty)\n" >&2
    exit 1
}

cmd_secret_export() {
    [[ ! -f "$SECRET_FILE" ]] && { log_error "'$SECRET_FILE' does not exist." >&2; exit 1; }
    export GPG_TTY=$(tty)
    gpg-connect-agent updatestartuptty /bye >/dev/null 2>&1

    local tmp
    tmp="$(mktemp)"
    trap 'rm -f "$tmp"' RETURN EXIT INT TERM

    log_info "Unlocking secrets..." >&2

    if ! gpg --quiet --no-symkey-cache --decrypt "$SECRET_FILE" > "$tmp"; then
    # if ! gpg --quiet --decrypt "$SECRET_FILE" > "$tmp"; then
        rm -f "$tmp"
        if declare -f _gpg_fail_help > /dev/null; then
            _gpg_fail_help
        else
            log_error "GPG Decryption failed." >&2
            exit 1
        fi
    fi

    cat "$tmp"
}

cmd_secret() {
    local args=("$@")
    local action="${args[0]:-edit}" # Default to edit for convenience

    case "$action" in
        export) cmd_secret_export ;;
        edit)   cmd_secret_edit ;;
        *)
            log_error "Unknown secret command. Available: edit, export"
            return 1
            ;;
    esac
}

# -------------------------------- Install -------------------------------------

system_install() {
    if [[ "$system_type" == "arch" ]]; then
        if [[ $DRY_RUN -eq 1 ]]; then
           log_info "[DRY_RUN] Would execute: sudo pacman -S --noconfirm '$@'"
        else
	        log_debug "args: $@"
            sudo pacman -S --noconfirm "$@"
        fi 
    elif [[ "$system_type" == "debian" ]]; then
        if [[ $DRY_RUN -eq 1 ]]; then
           log_info "[DRY_RUN] Would execute: sudo apt install -y $@"
        else
            sudo apt install -y "$@"
        fi 
    else
        echo "Failed to install $@"
        exit 1
    fi
    return $?
}

cmd_install() {
    local targets=("$@")
    log_info "Executing: INSTALL"
    log_debug "Received targets: ${targets[*]:-(none)}"

    for target in "${targets[@]}"; do
        local script_path="$PROJECT_ROOT/install_scripts/${target}"

        if [[ -f "$script_path" ]]; then
            log_info "Running collection: $target"
            # Source the script so it can use system_install and your loggers
            source "$script_path"
            log_pass "Collection '$target' finished."
        else
            log_error "No installation script found for: $target"
        fi 
    done
}

# -------------------------------- Config --------------------------------------

system_stow() {
    local packages=("$@")
    if command -v stow &>/dev/null; then
        if [[ $DRY_RUN -eq 1 ]]; then
            log_info "[DRY_RUN] Would stow: ${packages[*]}"
        else
            log_info "Stowing: ${packages[*]}"
            # --no-folding will prevent files from being added to ~/.config and them show up in dev
            stow --no-folding -R -d "$PROJECT_ROOT/env" -t "$HOME" "${packages[@]}"
        fi
    else
        log_error "GNU Stow is not installed! Cannot configure ${packages[*]}"
        return 1
    fi
}
cmd_config() {
    local targets=("$@")
    log_info "Executing: CONFIG"
    log_debug "Received targets: ${targets[*]:-(none)}"

    for target in "${targets[@]}"; do
        local script_path="$PROJECT_ROOT/config_scripts/${target}"
        if [[ -f "$script_path" ]]; then
            log_info "Running configuration for: $target"
            source "$script_path"
            log_pass "Configuration '$target' finished."
        else
            log_error "No configuration script found for: $target"
        fi 
    done
}


# ---------------------------- Command Handling --------------------------------

case "$COMMAND" in
    install|i)  
        cmd_install "${NORMALIZED_TARGETS[@]}" 
        ;;
    config|c)   
        cmd_config "${NORMALIZED_TARGETS[@]}" 
        ;;
    secret|s)   
        cmd_secret "${NORMALIZED_TARGETS[@]}" 
        ;;
    *)
        log_error "Unknown command: '$COMMAND'"
        echo "Available commands: install (i), config (c), refresh (r)"
        exit 1
        ;;
esac
