#!/usr/bin/env bash

set -Eeuo pipefail
trap 'err_code=$?; echo -e "\x1b[38;2;255;0;0mERROR\x1b[0m: command [${BOLD}$BASH_COMMAND${NC}] failed with exit code $err_code in file ${BASH_SOURCE[0]} line $LINENO"; exit $err_code' ERR

script_dir=$(cd $(dirname "${BASH_SOURCE[0]}") &> /dev/null && pwd)
export PROJECT_ROOT=$script_dir
export script_dir

# --------------------------------- Vars ---------------------------------------

declare -i VERBOSE=0
declare -i DRY_RUN=0
declare -a POSITIONAL_ARGS

# ------------------------------ Debugging -------------------------------------

RED='\x1b[38;2;255;0;0m'
ORANGE='\x1b[38;2;255;160;70m'
GREEN='\x1b[38;2;0;255;0m'
BOLD='\x1b[1m'
LIGHTBLUE='\x1b[38;2;5;182;255m'
NC='\x1b[0m'

FAIL_COUNTER=0

log_pass() { echo -e "${GREEN}[PASS]${NC} $1"; }
log_fail() { echo -e "${RED}[FAIL]${NC} $1"; (( FAIL_COUNTER++ )); }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }
log_warn() { echo -e "${ORANGE}[WARN]${NC} $1"; }
log_info() { echo -e "${BOLD}[INFO]${NC} $1"; }
log_debug() { if [[ $VERBOSE -eq 1 ]]; then echo -e "${LIGHTBLUE}[DEBUG]${NC} $1"; fi }

# ------------------------------ Load Engine -----------------------------------

if [[ -f "$PROJECT_ROOT/lib/utils.sh" ]]; then
    source "$PROJECT_ROOT/lib/utils.sh"
else
    log_error "Core library missing: lib/utils.sh"
    exit 1
fi

# -------------------------------- Utils ---------------------------------------

usage() {
    cat <<EOF
Usage: dev [OPTIONS] <command> [targets...]

Commands:
  install, i    Install base packages and dependencies
  config, c     Apply dotfiles and configuration scripts
  plugin, p     Manage external configuration modules

Options:
  -h, --help    Show this help message
  -v, --verbose Enable verbose logging
  --dry-run     Simulate actions without making changes
EOF
}

get_sys() {
    system_type=$(uname -s)
    system_type="unknown"
    if [[ "$(uname -s)" == "Linux" ]]; then
        if [[ -f /etc/os-release ]]; then
            source /etc/os-release
            case "$ID" in #TODO: maybe change this to ID_LIKE
                debian|ubuntu)
                    system_type="debian"
                    ;;
                arch|manjaro)
                    system_type="arch"
                    ;;
                *)
                    system_type="linux"
                    ;;
            esac
        else
            if [[ "$(uname -o)" == "Android" ]]; then
                system_type="android"
            else
                system_type="linux"
            fi
        fi
    fi
    #NOTE: can add mac and windows here too
    export system_type
}
get_sys

assert_command() {
    if command -v "$1" &>/dev/null; then
        log_info "$1 is available"
        return 0;
    else
        log_warn "$1 is not available"
        return 1;
    fi
}

check_deps() {
    local missing=()
    for dep in "$@"; do
        if ! command -v "$dep" &>/dev/null; then
            missing+=("$dep")
        fi
    done

    if [[ ${#missing[@]} -gt 0 ]]; then
        log_error "Missing required dependencies: ${RED}${missing[*]}${NC}"
        return 1
    fi
    log_debug "All dependencies met: $*"
    return 0
}

# ----------------------------- CLI Handling -----------------------------------

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -v|--verbose)
            export VERBOSE=1
            shift # remove flag
            ;;
        --dry-run)
            export DRY_RUN=1
            shift
            ;;
        -*|--*)
            log_error "Unknown option: $1" >&2
            usage
            exit 1
            ;;
        *)
            POSITIONAL_ARGS+=("$1")
            shift
            ;;
    esac
done

export VERBOSE
export DRY_RUN

log_debug "system_type = $system_type"

if [[ ${#POSITIONAL_ARGS[@]} -eq 0 ]]; then
    usage
    exit 1
fi

log_debug "POSITIONAL_ARGS: ${POSITIONAL_ARGS[*]}"

# Substitutions for common targets with multiple names
declare -A TARGET_MAP=(
    ["nvim"]="neovim"
    ["python3"]="python"
    ["awesome"]="awesomewm"
)   

COMMAND="${POSITIONAL_ARGS[0]}"
log_debug "Parsed Command: $COMMAND"
RAW_TARGETS=("${POSITIONAL_ARGS[@]:1}")
log_debug "RAW_TARGETS: ${RAW_TARGETS[*]}"

declare -a NORMALIZED_TARGETS=()
normalize_target() {
    local input="$1"
    # swap the key if it exists in the map otherwise do nothing
    echo "${TARGET_MAP[$input]:-$input}"
}

for target in "${RAW_TARGETS[@]}"; do
    NORMALIZED_TARGETS+=("$(normalize_target "$target")")
done

log_debug "NORMALIZED_TARGETS: ${NORMALIZED_TARGETS[*]}"

# -------------------------------- Install -------------------------------------

system_install() {
    if [[ "$system_type" == "arch" ]]; then
        if [[ $DRY_RUN -eq 1 ]]; then
           log_info "[DRY_RUN] Would execute: sudo pacman -S --noconfirm '$@'"
        else
            log_debug "args: $@"
            sudo pacman -S --noconfirm "$@"
        fi 
    elif [[ "$system_type" == "debian" ]]; then
        if [[ $DRY_RUN -eq 1 ]]; then
           log_info "[DRY_RUN] Would execute: sudo apt install -y $@"
        else
            sudo apt install -y "$@"
        fi 
    elif [[ "$system_type" == "android" ]]; then
        if [[ $DRY_RUN -eq 1 ]]; then
           log_info "[DRY_RUN] Would execute: pkg install -y $@"
        else
            pkg install -y "$@"
        fi 
    else
        echo "Failed to install $@"
        exit 1
    fi
    return $?
}


# -------------------------------- Config --------------------------------------

system_stow() {
    local packages=("$@")
    
    # 1. Identify the exact directory of the script calling this function
    local caller_dir
    caller_dir="$(cd "$(dirname "${BASH_SOURCE[1]}")" && pwd)"
    
    # 2. Smart Path Resolution: Find the base directory (Core or Plugin)
    # This trims everything from "/config_scripts" or "/install_scripts" onward.
    local base_dir
    base_dir="${caller_dir%%/config_scripts*}"
    base_dir="${base_dir%%/install_scripts*}"
    
    local env_dir="$base_dir/env"

    # 3. Validate the path before we try to use it
    if [[ ! -d "$env_dir" ]]; then
        log_error "Could not locate 'env' directory. Expected at: $env_dir"
        return 1
    fi

    # 4. Execute Stow
    if command -v stow &>/dev/null; then
        if [[ $DRY_RUN -eq 1 ]]; then
            log_info "[DRY_RUN] Would stow: ${packages[*]} from $(basename "$base_dir")/env"
        else
            log_info "Stowing: ${packages[*]} from $env_dir"
            stow --no-folding -R -d "$env_dir" -t "$HOME" "${packages[@]}"
        fi
    else
        log_error "GNU Stow is not installed! Cannot configure ${packages[*]}"
        return 1
    fi
}



# ------------------------------ Execution Router ------------------------------

execute_script() {
    local script_type="$1" # "install" or "config"
    local target="$2"
    
    local search_paths=("$PROJECT_ROOT")
    if [[ -d "$PROJECT_ROOT/plugins" ]]; then
        for plugin in "$PROJECT_ROOT/plugins"/*; do
            [[ -d "$plugin" ]] && search_paths+=("$plugin")
        done
    fi

    for base_path in "${search_paths[@]}"; do
        local target_path="$base_path/${script_type}_scripts/$target"
        local origin_name
        origin_name="$(basename "$base_path")"
        
        if [[ -d "$target_path" && -f "$target_path/init.sh" ]]; then
            log_info "Running $script_type module: $target [via $origin_name]"
            source "$target_path/init.sh"
            log_pass "Module '$target' finished."
            return 0
        elif [[ -f "$target_path" ]]; then
            log_info "Running $script_type script: $target [via $origin_name]"
            source "$target_path"
            log_pass "Script '$target' finished."
            return 0
        fi
    done
    
    log_error "No $script_type script/module found for: $target"
    return 1
}

cmd_install() {
    if [[ $# -eq 0 ]]; then
        log_error "No targets specified for installation."
        echo "Usage: dev install <target1> [target2...]"
        return 1
    fi
    
    log_info "Executing: INSTALL"
    for target in "$@"; do execute_script "install" "$target"; done
}

cmd_config() {
    if [[ $# -eq 0 ]]; then
        log_error "No targets specified for configuration."
        echo "Usage: dev config <target1> [target2...]"
        return 1
    fi

    log_info "Executing: CONFIG"
    for target in "$@"; do execute_script "config" "$target"; done
}

# -------------------------------- Plugins -------------------------------------

# Predefined Plugin Registry (Update these URLs with your actual repositories)
declare -A PLUGIN_REGISTRY=(
    ["dev-desktop"]="git@github.com:YourUser/dev-desktop.git"
    ["dev-writing"]="git@github.com:YourUser/dev-writing.git"
)

cmd_plugin() {
    local action="${1:-}"
    local target="${2:-}"
    local plugins_dir="$PROJECT_ROOT/plugins"

    mkdir -p "$plugins_dir"

    case "$action" in
        add)
            if [[ -z "$target" ]]; then
                log_error "Usage: dev plugin add <plugin-name>"
                return 1
            fi
            
            local repo_url="${PLUGIN_REGISTRY[$target]:-}"
            if [[ -z "$repo_url" ]]; then
                log_error "Plugin '$target' not found in the registry."
                return 1
            fi

            if [[ -d "$plugins_dir/$target" ]]; then
                log_warn "Plugin '$target' is already installed."
            else
                log_info "Cloning plugin '$target'..."
                git clone "$repo_url" "$plugins_dir/$target"
                log_pass "Plugin '$target' installed and ready to route."
            fi
            ;;
        update)
            log_info "Updating all plugins..."
            for plugin in "$plugins_dir"/*; do
                if [[ -d "$plugin/.git" ]]; then
                    log_info "Pulling $(basename "$plugin")..."
                    git -C "$plugin" pull
                fi
            done
            ;;
        list)
            log_info "Available plugins in registry:"
            for key in "${!PLUGIN_REGISTRY[@]}"; do
                echo "  - $key"
            done
            ;;
        *)
            log_error "Unknown plugin action. Use: add, update, list"
            ;;
    esac
}

# ---------------------------- Command Handling --------------------------------

# Notice: The 'shift' command has been removed from here!

case "$COMMAND" in
    install|i)  
        cmd_install "${NORMALIZED_TARGETS[@]:-}" 
        ;;
    config|c)   
        cmd_config "${NORMALIZED_TARGETS[@]:-}" 
        ;;
    plugin|p)
        cmd_plugin "${RAW_TARGETS[@]:-}"
        ;;
    *)
        log_error "Unknown command: '$COMMAND'"
        echo "Available commands: install (i), config (c), plugin (p)"
        exit 1
        ;;
esac
