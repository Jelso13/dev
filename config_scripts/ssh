# Note: No #!/usr/bin/env bash needed, as this is strictly sourced by ./dev

log_info "=== Configuring SSH & Git ==="

# 1. Ensure jq is installed using your custom dependency checker
check_deps jq || return 1

# 2. Fetch the decrypted JSON using the locally available function
log_info "Unlocking secrets..."
if ! SECRETS_JSON=$(cmd_secret_export); then
    log_error "Failed to decrypt secrets. Aborting SSH configuration."
    return 1 # Use return, not exit, so it doesn't kill the whole dev script!
fi

# 3. Extract and Deploy
log_info "Deploying SSH Private Key..."
SSH_KEY=$(printf "%s\n" "$SECRETS_JSON" | jq -r '.ssh.private_key // empty')

if [[ -n "$SSH_KEY" ]]; then
    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"
    printf "%s\n" "$SSH_KEY" > "$HOME/.ssh/id_rsa"
    chmod 600 "$HOME/.ssh/id_rsa"
    log_pass "SSH key deployed to ~/.ssh/id_rsa"
else
    log_error "ssh.private_key not found in payload."
fi

log_info "Configuring Git Global Identity..."
GIT_NAME=$(printf "%s\n" "$SECRETS_JSON" | jq -r '.git.name // empty')
GIT_EMAIL=$(printf "%s\n" "$SECRETS_JSON" | jq -r '.git.email // empty')

if [[ -n "$GIT_NAME" && -n "$GIT_EMAIL" ]]; then
    git config --global user.name "$GIT_NAME"
    git config --global user.email "$GIT_EMAIL"
    log_pass "Git configured for $GIT_NAME <$GIT_EMAIL>"
fi

# 4. Clean up memory locally
unset SECRETS_JSON
