FROM debian:latest

# Install base tools, but DO NOT install sudo
RUN apt-get update && apt-get install -y git stow curl wget vim tree

# Create a non-root user (no sudoers file modification)
RUN useradd -m -s /bin/bash tester

USER tester
WORKDIR /home/tester
COPY --chown=tester:tester . /home/tester/dev
